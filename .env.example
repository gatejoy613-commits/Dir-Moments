DATABASE_URL=postgres://app:app@localhost:5432/directory
# Password for /admin
ADMIN_PASSWORD=change-me
# Used to sign the admin session cookie
SESSION_SECRET=replace-with-a-long-random-string

# Supabase Storage holds vendor photo uploads. Both come from
# Project Settings > API: the project URL, and the service_role key.
# The service_role key bypasses row-level security, so it is server-only -
# never expose it to the browser and never commit it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional, defaults to "media"
# SUPABASE_STORAGE_BUCKET=media

DATABASE_URL=postgres://app:app@localhost:5432/directory
# Signs session cookies and password reset links. Admins are accounts with the
# admin role: sign up, then run `npm run make-admin -- you@example.com`.
SESSION_SECRET=replace-with-a-long-random-string

# Supabase Storage holds vendor photo uploads. Both come from
# Project Settings > API: the project URL, and the service_role key.
# The service_role key bypasses row-level security, so it is server-only -
# never expose it to the browser and never commit it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional, defaults to "media"
# SUPABASE_STORAGE_BUCKET=media

# Password reset links are sent through Resend (resend.com).
# The free tier is 3,000 a month; sending to real addresses needs a verified
# domain. Supabase's own auth mailer is not usable here: two emails an hour
# for the whole project, and only to members of your Supabase organisation.
RESEND_API_KEY=re_your_api_key
MAIL_FROM=Dir Moments <login@yourdomain.com>

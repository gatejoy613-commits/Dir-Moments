{
  "name": "dir-moments",
  "version": "1.0.0",
  "description": "Phase A event vendor directory for Addis Ababa",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "storage:setup": "tsx --env-file=.env scripts/setup-storage.ts",
    "test": "tsx scripts/check-calendar.ts",
    "make-admin": "tsx --env-file=.env scripts/make-admin.ts"
  },
  "dependencies": {
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
